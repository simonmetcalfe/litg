---
import Carousel from './Carousel.astro';
import { glampingPhotos, campingPhotos, sectionHeadings } from '../data/site';
---

<section id="accommodation" class="section-alt py-20 px-4 md:px-8 lg:px-16">
  <div class="max-w-7xl mx-auto">

    <!-- Heading -->
    <div class="text-center mb-12">
      <h2 class="font-bangers text-lotg-green section-h2 tracking-wider text-outline-lg leading-none">
        {sectionHeadings['accommodation']}
      </h2>
      <p class="text-lotg-yellow text-lg tracking-wide mt-2">Camping & Glamping on site</p>
    </div>

    <!-- Sectioned carousel -->
    <Carousel
      sections={[
        { label: 'Glamping', images: glampingPhotos },
        { label: 'Camping',  images: campingPhotos  },
      ]}
      altPrefix="Accommodation photo"
      class="rounded-2xl overflow-hidden shadow-2xl border border-lotg-green/20 mb-12"
      aspectClass="aspect-video"
    />

    <!-- Summary -->
    <p class="text-lotg-offwhite text-lg leading-relaxed">
      Stay on site in your own tent — quiet and family camping areas are available — or treat yourself to one of the furnished glamping pods, subject to availability.
      Dogs are very welcome. <a href="#tickets" class="text-lotg-green hover:underline">Tickets</a> has full pricing info.
    </p>

  </div>
</section>
