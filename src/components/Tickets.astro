---
import { sectionHeadings, ticketTiers, ticketUrl } from '../data/site';
---

<section id="tickets" class="bg-lotg-dark py-20 px-4 md:px-8 lg:px-16">
  <div class="max-w-5xl mx-auto text-center">

    <!-- Heading -->
    <h2 class="font-bangers text-lotg-blue section-h2 tracking-wider text-outline-lg leading-none mb-12">
      {sectionHeadings['tickets']}
    </h2>

    <!-- Weekend ticket price tiers -->
    <div class="grid md:grid-cols-3 gap-4 mb-4">
      {ticketTiers.map(tier => (
        <div class="bg-lotg-card rounded-2xl p-6 border border-lotg-orange/40 flex flex-col items-center gap-4 hover:border-lotg-orange hover:shadow-[0_0_20px_rgba(247,120,42,0.2)] transition-all">
          <div>
            <h3 class="font-bangers text-lotg-yellow text-3xl tracking-wide">{tier.name}</h3>
            <p class="text-lotg-orange text-sm uppercase tracking-wide">{tier.dates}</p>
          </div>
          <div class="w-full grid grid-cols-2 gap-4">
            {[
              { emoji: '🎟️', label: 'Adult weekend', ticket: tier.adult },
              { emoji: '🦕', label: 'Child weekend', ticket: tier.child },
            ].map(({ emoji, label, ticket }) => (
              <div class="flex flex-col items-center gap-1">
                <span class="text-2xl">{emoji}</span>
                <p class="text-lotg-offwhite/70 text-sm">{label}</p>
                <p class="font-bangers text-lotg-orange text-5xl">{ticket.price}</p>
                {ticket.saving && (
                  <p class="text-lotg-orange text-xs uppercase">{ticket.saving}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="text-lotg-offwhite/50 text-sm mb-8">
      Adults 18+ · Children ages 5–17 · <span class="text-lotg-orange uppercase">Under 5s FREE</span>
    </p>

    <!-- Camping & accommodation -->
    <div class="grid sm:grid-cols-2 gap-4 mb-4">

      <!-- Campervans -->
      <div class="bg-lotg-card rounded-2xl p-6 border border-lotg-orange/30 flex flex-col items-center gap-2">
        <span class="text-3xl">🚐</span>
        <h3 class="font-bangers text-lotg-yellow text-2xl tracking-wide">Campervans</h3>
        <p class="font-bangers text-lotg-orange text-5xl">£30</p>
        <p class="text-lotg-offwhite/50 text-sm">Per van</p>
        <p class="text-lotg-offwhite/40 text-xs">Elec hookup £35</p>
      </div>

      <!-- Lunar Tents -->
      <div class="bg-lotg-card rounded-2xl p-6 border border-lotg-orange/30 flex flex-col items-center gap-2">
        <span class="text-3xl">🌙</span>
        <h3 class="font-bangers text-lotg-yellow text-2xl tracking-wide">Lunar Tents</h3>
        <p class="font-bangers text-lotg-orange text-5xl">£360</p>
        <p class="text-lotg-offwhite/50 text-sm">Per tent · 1–4 guests</p>
        <p class="text-lotg-offwhite/40 text-xs">No towels provided</p>
        <a
          href={ticketUrl}
          target="_blank"
          rel="noopener"
          class="text-lotg-orange text-xs uppercase hover:underline"
        >Check availability on OTG website</a>
      </div>

    </div>

    <!-- Dogs card – slim -->
    <div class="bg-lotg-card rounded-2xl px-6 py-4 border border-lotg-orange/20 flex items-center justify-center gap-4 mb-10">
      <span class="text-2xl">🐕</span>
      <h3 class="font-bangers text-lotg-yellow text-2xl tracking-wide">Dogs</h3>
      <p class="font-bangers text-lotg-orange text-3xl">£5</p>
      <p class="text-lotg-offwhite/50 text-sm">Per dog</p>
    </div>

    <!-- CTA -->
    <a
      href={ticketUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-3 bg-lotg-blue text-lotg-offwhite text-2xl px-10 py-4 rounded-full font-bold uppercase hover:bg-lotg-yellow hover:text-lotg-dark hover:scale-105 transition-all duration-200 shadow-[0_0_30px_rgba(26,86,255,0.4)]"
    >
      Buy Tickets Now
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>

  </div>
</section>
