---
import { asset } from '../utils';
import Logo from './Logo.astro';
import { newsletterSignupUrl, ticketUrl } from '../data/site';
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden pt-20 xl:pt-28 2xl:pt-32"
>
  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    <img
      src={asset('background/background_poster_2027.jpeg')}
      alt="Lost in the Grass micro-festival scene"
      class="w-full h-full object-cover object-center"
      loading="eager"
    />
    <!-- Dark overlay for text legibility -->
    <div class="absolute inset-0 bg-gradient-to-b from-lotg-dark/60 via-lotg-dark/40 to-lotg-dark/80"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col items-center text-center px-4 max-w-4xl mx-auto">

    <!-- Festival logo -->
    <Logo
      tag="h1"
      class="text-[2.1rem] sm:text-[2.6rem] md:text-[3.05rem] lg:text-[3.5rem] animate-fade-up drop-shadow-2xl"
    />

    <!-- Dates -->
    <p class="mt-0.5 font-frijole text-lotg-yellow text-2xl md:text-3xl lg:text-4xl leading-none tracking-normal logo-outline drop-shadow-lg animate-fade-up">
      20–22 Aug 2027
    </p>

    <!-- Tagline -->
    <p class="mt-6 text-lotg-offwhite text-xl md:text-2xl lg:text-3xl tracking-wide max-w-xl leading-snug animate-fade-up-delay drop-shadow-lg">
      Music · Camping · Family Fun Near Malvern
    </p>

    <!-- CTA buttons -->
    <div class="mt-8 flex flex-wrap gap-4 justify-center animate-fade-up-delay2">
      <a
        href={ticketUrl}
        target="_blank"
        rel="noopener"
        class="bg-lotg-blue text-lotg-offwhite px-8 py-3 rounded-full text-xl uppercase font-bold hover:bg-lotg-yellow hover:text-lotg-dark hover:scale-105 transition-all duration-200 shadow-lg"
      >
        Get Tickets
      </a>
      <a
        href="/2026"
        class="border-2 border-lotg-blue text-lotg-offwhite px-8 py-3 rounded-full text-xl uppercase font-bold hover:bg-lotg-blue hover:scale-105 transition-all duration-200"
      >
        See 2026 website
      </a>
    </div>

    <!-- Venue -->
    <div class="mt-8 space-y-2 animate-fade-up-delay2">
      <p class="text-lotg-offwhite/70 text-base tracking-widest uppercase">
        <a
          href={newsletterSignupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 decoration-lotg-offwhite/30 hover:text-lotg-yellow hover:decoration-lotg-yellow transition-colors"
        >
          Sign up to Newsletter
        </a>
      </p>
      <p class="text-lotg-offwhite/70 text-base tracking-widest uppercase">
        A Micro-Festival · Hosted at Out to Grass Woodend Farm · Malvern
      </p>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <span class="material-icons text-lotg-yellow" style="font-size:28px">expand_more</span>
  </div>
</section>
