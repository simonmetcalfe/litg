---
import { openingTimes, goodToKnowGroups, newsletterSignupUrl, sectionHeadings } from '../data/site';
---

<section id="good-to-know" class="section-alt py-20 px-4 md:px-8 lg:px-16">
  <div class="max-w-4xl mx-auto">

    <div class="text-center mb-12">
      <h2 class="font-bangers text-lotg-green section-h2 tracking-wider text-outline-lg leading-none">
        {sectionHeadings['good-to-know']}
      </h2>
      <p class="mt-6 text-lotg-offwhite text-lg leading-relaxed">
        To keep yourself informed, please
        <a
          href={newsletterSignupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 decoration-lotg-green/40 hover:text-lotg-green hover:decoration-lotg-green transition-colors"
        >
          sign up to our newsletter
        </a>
        if you haven't already!
      </p>
    </div>

    <div class="space-y-8">
      {goodToKnowGroups.map(group => (
        <div>
          <h3 class="font-bangers text-lotg-yellow text-2xl tracking-wide mb-3">{group.title}</h3>
          <div class="space-y-2">
            {group.items.map(item => (
              <div class="flex items-start gap-3 bg-lotg-mid border border-lotg-green/20 rounded-xl px-4 py-3">
                <span class="text-xl shrink-0 mt-0.5">{item.emoji}</span>
                <p class="text-lotg-offwhite text-sm leading-relaxed">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 bg-lotg-card rounded-2xl p-6 border border-lotg-green/20">
      <h3 class="font-bangers text-lotg-green text-3xl tracking-wide mb-5">Opening Times</h3>
      <div class="space-y-2">
        {openingTimes.map(row => (
          <div class="flex justify-between gap-4 border-b border-lotg-green/10 pb-2 last:border-0 last:pb-0">
            <span class="text-lotg-offwhite/70 text-sm uppercase tracking-wide">{row.label}</span>
            <span class="text-lotg-green text-sm text-right">{row.times}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
