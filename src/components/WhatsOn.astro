---
import Carousel from './Carousel.astro';
import NewsletterNudge from './NewsletterNudge.astro';
import { activityCategories, activityPhotos, cafeBarMenu, newsletterSignupUrl, sectionHeadings } from '../data/site';
---

<section id="activities-and-food" class="bg-lotg-dark py-20 px-4 md:px-8 lg:px-16">
  <div class="max-w-7xl mx-auto">

    <!-- Heading -->
    <div class="text-center mb-12">
      <h2 class="font-bangers text-lotg-blue section-h2 tracking-wider text-outline-lg leading-none">
        {sectionHeadings['activities-and-food']}
      </h2>
    </div>

    <!-- Photo carousel -->
    <Carousel
      images={activityPhotos}
      altPrefix="Activity photo"
      class="rounded-2xl overflow-hidden shadow-2xl border border-lotg-orange/20 mb-12"
      aspectClass="aspect-video"
    />

    <!-- Activity categories -->
    <div class="grid md:grid-cols-2 gap-4">
      {activityCategories.map(cat => (
        <div
          id={`activity-${cat.id}`}
          class={`scroll-mt-24 lg:scroll-mt-28 bg-lotg-card rounded-2xl border ${cat.accent === 'yellow' ? 'border-lotg-yellow/20' : 'border-lotg-orange/20'}`}
        >
          <div class="flex items-center gap-3 p-6 pb-4">
            <span class="text-3xl">{cat.emoji}</span>
            <h3 class="font-bangers text-lotg-yellow text-3xl tracking-wide">
              {cat.title}
            </h3>
          </div>
          {cat.intro && (
            <p class="px-6 pb-4 text-lotg-offwhite/80 text-sm leading-relaxed">{cat.intro}</p>
          )}
          <ul class="px-6 pb-6 space-y-3">
            {cat.items.map(item => (
              <li class="flex items-start gap-2 text-lotg-offwhite">
                <span class="mt-0.5 shrink-0 text-lotg-yellow">✦</span>
                <div class="min-w-0">
                  {item.href ? (
                    <a
                      href={item.href}
                      class="tracking-wide underline underline-offset-4 decoration-lotg-yellow/40 hover:text-lotg-yellow hover:decoration-lotg-yellow transition-colors"
                    >
                      {item.text}
                    </a>
                  ) : (
                    <span class="tracking-wide">{item.text}</span>
                  )}
                  {item.times && item.times.length > 0 && (
                    <div class="mt-1 text-lotg-offwhite/70 text-sm leading-relaxed">
                      {item.times.map(line => (
                        <div>{line}</div>
                      ))}
                    </div>
                  )}
                  {item.links && item.links.length > 0 && (
                    <div class="mt-1 flex flex-wrap gap-x-4 text-sm">
                      {item.links.map(link => (
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-lotg-yellow underline underline-offset-4 decoration-lotg-yellow/40 hover:decoration-lotg-yellow transition-colors"
                        >
                          {link.label}
                        </a>
                      ))}
                    </div>
                  )}
                  {item.cta && (
                    <a
                      href={item.cta.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-2 inline-block rounded-full bg-lotg-blue px-4 py-1.5 text-sm font-semibold text-lotg-offwhite hover:bg-lotg-yellow hover:text-lotg-dark transition-colors"
                    >
                      {item.cta.label}
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
          {cat.newsletterNudge && <NewsletterNudge class="px-6 pb-6 -mt-2" />}
        </div>
      ))}
    </div>

    <!-- Cafe & Bar menu -->
    <div id="cafe-and-bar-menu" class="scroll-mt-24 lg:scroll-mt-28 mt-16 max-w-3xl mx-auto">
      <h3 class="font-bangers text-lotg-yellow text-3xl md:text-4xl tracking-wide text-center mb-6">
        Cafe &amp; Bar Menu
      </h3>
      <p class="text-lotg-offwhite text-lg leading-relaxed text-center mb-8">
        {cafeBarMenu.intro}
        {' '}
        To keep yourself informed, please
        <a
          href={newsletterSignupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 decoration-lotg-yellow/40 hover:text-lotg-yellow hover:decoration-lotg-yellow transition-colors"
        >
          sign up to our newsletter
        </a>
        if you haven't already!
        {' '}
        {cafeBarMenu.snacksNote}
      </p>

      <div class="grid sm:grid-cols-2 gap-6">
        <div class="bg-lotg-card rounded-2xl border border-lotg-orange/20 p-5 text-center">
          <p class="font-bangers text-lotg-yellow text-2xl tracking-wide mb-2">Cafe Menu</p>
          <p class="text-lotg-offwhite/70 text-sm">To be confirmed</p>
        </div>
        <div class="bg-lotg-card rounded-2xl border border-lotg-orange/20 p-5 text-center">
          <p class="font-bangers text-lotg-yellow text-2xl tracking-wide mb-2">Mal's Bar Menu</p>
          <p class="text-lotg-offwhite/70 text-sm">To be confirmed</p>
        </div>
      </div>
    </div>

    <!-- Kids Cinema -->
    <div id="kids-cinema" class="scroll-mt-24 lg:scroll-mt-28 mt-16 max-w-3xl mx-auto">
      <h3 class="font-bangers text-lotg-yellow text-3xl md:text-4xl tracking-wide text-center mb-6">
        Kids Cinema
      </h3>
      <p class="text-center text-lotg-offwhite/70 text-sm">To be confirmed</p>
      <NewsletterNudge class="mt-2 text-center" />
    </div>

    <p class="mt-8 text-center text-lotg-offwhite/70 text-sm leading-relaxed max-w-2xl mx-auto">
      We endevour to provide everything listed here, but as a small festival, some events, activities, or catering may change. We'll do our best to keep you informed by updating the website and informing ticket holders via email.
    </p>

  </div>
</section>

