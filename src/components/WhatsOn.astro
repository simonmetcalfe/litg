---
import { activityCategories, openingTimes } from '../data/site';
---

<section id="whats-on" class="bg-lotg-dark py-20 px-4 md:px-8 lg:px-16">
  <div class="max-w-7xl mx-auto">

    <!-- Heading -->
    <div class="text-center mb-12">
      <h2 class="font-bangers text-lotg-green text-6xl md:text-8xl tracking-wider text-outline-lg leading-none">
        Activities &amp; Food
      </h2>
    </div>

    <!-- Accordion categories -->
    <div class="grid md:grid-cols-2 gap-4 mb-10">
      {activityCategories.map(cat => (
        <details open class={`group bg-lotg-card rounded-2xl border ${cat.accent === 'yellow' ? 'border-lotg-yellow/20' : 'border-lotg-green/20'} open:border-opacity-60 transition-colors`}>
          <summary class="flex items-center justify-between gap-3 p-6 cursor-pointer list-none select-none">
            <div class="flex items-center gap-3">
              <span class="text-3xl">{cat.emoji}</span>
              <h3 class={`font-bangers text-3xl tracking-wide ${cat.accent === 'yellow' ? 'text-lotg-yellow' : 'text-lotg-green'}`}>
                {cat.title}
              </h3>
            </div>
          </summary>
          <ul class="px-6 pb-6 space-y-2">
            {cat.items.map(item => (
              <li class="flex items-start gap-2 text-lotg-offwhite">
                <span class={`mt-0.5 shrink-0 ${cat.accent === 'yellow' ? 'text-lotg-yellow' : 'text-lotg-green'}`}>✦</span>
                <span class="tracking-wide">{item}</span>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>

    <!-- Opening times -->
    <div class="bg-lotg-card rounded-2xl p-6 border border-lotg-green/20">
      <h3 class="font-bangers text-lotg-green text-3xl tracking-wide mb-5">Opening Times</h3>
      <div class="space-y-2">
        {openingTimes.map(row => (
          <div class="flex justify-between gap-4 border-b border-lotg-green/10 pb-2 last:border-0 last:pb-0">
            <span class="text-lotg-offwhite/70 text-sm uppercase tracking-wide">{row.label}</span>
            <span class="text-lotg-green text-sm text-right">{row.times}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
