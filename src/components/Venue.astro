---
import Carousel from './Carousel.astro';
import { venuePhotoSections, sectionHeadings } from '../data/site';
---

<section id="venue" class="section-alt py-20 px-4 md:px-8 lg:px-16">
  <div class="max-w-7xl mx-auto">

    <!-- Heading -->
    <div class="text-center mb-12">
      <h2 class="font-bangers text-lotg-green section-h2 tracking-wider text-outline-lg leading-none">
        {sectionHeadings['venue']}
      </h2>
    </div>

    <!-- Sectioned carousel -->
    <Carousel
      sections={venuePhotoSections}
      altPrefix="Venue photo"
      class="rounded-2xl overflow-hidden shadow-2xl border border-lotg-green/20 mb-12"
      aspectClass="aspect-video"
    />

    <!-- Description – full width -->
    <p class="text-lotg-offwhite text-lg leading-relaxed">
      Lost in the Grass is hosted at <a href="https://www.outtograss.com" target="_blank" rel="noopener" class="text-lotg-green hover:underline font-semibold">Out to Grass</a> —
      a working farm tucked into the Malvern Hills with a geodome stage, wood-fired hot tub, bar, café, and fire pits.
      You pitch your tent, walk to the stage, and that's your commute sorted.
    </p>

  </div>
</section>
