---
import { asset } from '../utils';
import { sectionHeadings } from '../data/site';
import ContactButton from './ContactButton.astro';
---

<section id="contact" class="bg-lotg-dark py-20 px-4 md:px-8 lg:px-16">
  <div class="max-w-4xl mx-auto text-center">

    <h2 class="font-bangers text-lotg-green section-h2 tracking-wider text-outline-lg leading-none mb-12">
      {sectionHeadings['contact']}
    </h2>

    <!-- Contact options -->
    <div class="grid md:grid-cols-2 gap-6 mb-14 text-left">
      <div class="bg-lotg-card border border-lotg-green/20 rounded-2xl p-6 flex flex-col gap-4">
        <h3 class="font-bangers text-lotg-yellow text-2xl tracking-wide">General enquiries</h3>
        <p class="text-lotg-offwhite text-sm leading-relaxed flex-1">
          For general enquiries about the venue, camping, accommodation and the facilities, please contact OTG directly, who are helping us with these requests.
        </p>
        <ContactButton
          href="mailto:infoouttograss@gmail.com"
          icon="✉️"
          label="infoouttograss@gmail.com"
          class="mt-auto self-start"
        />
      </div>

      <div class="bg-lotg-card border border-lotg-green/20 rounded-2xl p-6 flex flex-col gap-4">
        <h3 class="font-bangers text-lotg-yellow text-2xl tracking-wide">Performing &amp; getting involved</h3>
        <p class="text-lotg-offwhite text-sm leading-relaxed flex-1">
          If you're interested in performing or getting involved.
        </p>
        <ContactButton
          href="https://instagram.com/l0st_in_the_grass"
          iconSrc={asset('icons_social/Instagram-Logo.wine.png')}
          iconAlt="Instagram"
          label="@l0st_in_the_grass"
          external
          class="mt-auto self-start"
        />
      </div>
    </div>

    <!-- Hosted by -->
    <div class="flex flex-col items-center gap-4 mb-10">
      <p class="text-lotg-offwhite/40 text-xs uppercase tracking-widest">Hosted by</p>
      <a href="https://www.outtograss.com" target="_blank" rel="noopener" class="opacity-70 hover:opacity-100 transition-opacity">
        <img
          src={asset('logo_venue_farm/otg-logo.png')}
          alt="Out to Grass"
          class="h-12"
          loading="lazy"
        />
      </a>
      <a
        href="https://maps.app.goo.gl/pnr4GmAQKsL5SxAZ8"
        target="_blank"
        rel="noopener"
        class="text-lotg-offwhite/40 text-sm hover:text-lotg-green transition-colors"
      >
        Out to Grass, Woodend Farm, Bromyard Rd, Malvern, WR13 5JW
      </a>
    </div>

    <!-- Footer -->
    <div class="border-t border-lotg-green/10 pt-8 space-y-2">
      <img
        src={asset('logo/website_logo.png')}
        alt="Lost in the Grass"
        class="h-12 mx-auto opacity-80"
        loading="lazy"
      />
      <p class="text-lotg-offwhite/30 text-xs tracking-wider">
        © 2026 Echofields · Lost in the Grass · All rights reserved
      </p>
    </div>

  </div>
</section>
