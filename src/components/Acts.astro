---
import NewsletterNudge from './NewsletterNudge.astro';
import { contactEmail, instagramHandle, instagramUrl, sectionHeadings } from '../data/site';

const linkClass =
  'text-lotg-green underline underline-offset-4 decoration-lotg-green/40 hover:decoration-lotg-green transition-colors';
---

<section id="lineup" class="bg-lotg-dark py-20 px-4 md:px-8 lg:px-16">
  <div class="max-w-3xl mx-auto text-center">

    <!-- Section heading -->
    <h2 class="font-bangers text-lotg-green section-h2 tracking-wider text-outline-lg leading-none mb-10">
      {sectionHeadings['lineup']}
    </h2>

    <div class="space-y-5 text-lotg-offwhite text-lg leading-relaxed">
      <p>
        We're still building the lineup for 2027. If you'd like to take part, please get in touch by
        email at <a href={`mailto:${contactEmail}`} class={linkClass}>{contactEmail}</a>
        or on Instagram at
        <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>{instagramHandle}</a>.
      </p>
      <p>
        Last year's lineup was awesome, and we're looking to invite many of our great acts back.
        Take a look at the 2026 lineup to get a taste of what's to come.
      </p>
    </div>

    <a
      href="/2026#lineup"
      class="mt-10 inline-flex items-center gap-3 bg-lotg-green text-lotg-dark text-xl px-8 py-3 rounded-full font-bold uppercase hover:bg-lotg-yellow hover:scale-105 transition-all duration-200 shadow-lg"
    >
      See our 2026 lineup
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>

    <NewsletterNudge class="mt-6" />

  </div>
</section>
