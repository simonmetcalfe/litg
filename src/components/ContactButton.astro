---
interface Props {
  href: string;
  label: string;
  icon?: string;
  iconSrc?: string;
  iconAlt?: string;
  external?: boolean;
  class?: string;
}

const {
  href,
  label,
  icon,
  iconSrc,
  iconAlt = '',
  external = false,
  class: className = '',
} = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-flex items-center gap-3 bg-lotg-mid border border-lotg-green/30 rounded-full px-7 h-14 hover:border-lotg-green hover:bg-lotg-green/10 transition-all duration-200 group',
    className,
  ]}
>
  <span class="w-10 h-10 shrink-0 flex items-center justify-center">
    {iconSrc ? (
      <img src={iconSrc} alt={iconAlt} class="w-10 h-10 object-contain" />
    ) : (
      <span class="text-2xl leading-none" aria-hidden="true">{icon}</span>
    )}
  </span>
  <span class="font-bangers text-xl text-lotg-offwhite tracking-wide group-hover:text-lotg-green transition-colors">
    {label}
  </span>
</a>
