---
import '../styles/global.css';
import { absoluteAsset, asset } from '../utils';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lost in the Grass | 20–22 Aug 2027',
  description = 'A weekend of live music, camping & family-friendly fun near Malvern. 20–22 August 2027.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteAsset('logo/website_socialcard_2027.png')} />
    <meta property="og:image:width" content="490" />
    <meta property="og:image:height" content="258" />
    <meta property="og:url" content={import.meta.env.SITE + import.meta.env.BASE_URL} />
    <meta name="theme-color" content="#070B2E" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteAsset('logo/website_socialcard_2027.png')} />
    <link rel="icon" type="image/png" href={asset('logo/website_logo.png')} />

    <link
      rel="preload"
      href={asset('fonts/Bangers_main_body/Bangers-Regular.ttf')}
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href={asset('fonts/Frijole_logo/Frijole-Regular.ttf')}
      as="font"
      type="font/ttf"
      crossorigin
    />
  </head>
  <body class="bg-lotg-dark text-lotg-offwhite font-bangers antialiased">
    <slot />
  </body>
</html>
